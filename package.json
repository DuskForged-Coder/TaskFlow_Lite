{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "A local-first terminal productivity assistant",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "predev": "node scripts/ensure-sqlite-native.mjs",
    "dev": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "node scripts/ensure-sqlite-native.mjs",
    "start": "node dist/index.js",
    "pretest": "node scripts/ensure-sqlite-native.mjs",
    "orb": "electron src/desktop/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^12.2.0",
    "chrono-node": "^2.8.0",
    "ink": "^6.2.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "electron": "^44.5.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}